# TapMe Frontend Configuration Template
# Copy to .env.local for local overrides. Do not commit actual secrets or production domains.

# ==============================================================================
# VITE_PUBLIC_REDIRECT_BASE_URL (BUILD-TIME Vite Variable)
# ==============================================================================
# IMPORTANT: This is a static BUILD-TIME variable embedded into the client JS
# bundle by Vite (import.meta.env.VITE_PUBLIC_REDIRECT_BASE_URL).
# It is NOT a Cloudflare Pages runtime environment variable.
#
# Canonical public base URL encoded into generated QR codes.
# Format: protocol + domain (no trailing slash).
#
# In local development:
#   Defaults to http://127.0.0.1:8787 if unset (Cloudflare Worker dev server).
#   When developing through the Vite dev server proxy (http://localhost:5173),
#   you can optionally set:
#   VITE_PUBLIC_REDIRECT_BASE_URL=http://localhost:5173
#
# In production (Cloudflare Pages):
#   REQUIRED AT BUILD TIME. Must be set to your public Cloudflare Pages hostname
#   (e.g., https://<your-project>.pages.dev).
#
#   When building locally or in CI, set it in the shell prior to building:
#     PowerShell (Windows):
#       $env:VITE_PUBLIC_REDIRECT_BASE_URL="https://<your-project>.pages.dev"
#       npm --prefix frontend run build
#
#     Bash / Linux:
#       VITE_PUBLIC_REDIRECT_BASE_URL="https://<your-project>.pages.dev" npm --prefix frontend run build
#
#   Production builds will FAIL immediately if this variable is missing or
#   points to localhost, 127.0.0.1, or a private LAN IP (e.g. 192.168.x.x, 10.x.x.x).
#
VITE_PUBLIC_REDIRECT_BASE_URL=https://tapme-ayd.pages.dev
