/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
 
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"observability": {
		"enabled": true
	},
	"vars": {
		/**
		 * ADMIN_ORIGINS: Permitted frontend origin(s) for CORS and CSRF protection.
		 * In local development, defaults to "http://localhost:5173".
		 * In production with Cloudflare Pages (same-origin architecture via Service Binding):
		 *   Set ADMIN_ORIGINS to your Cloudflare Pages public domain, e.g.:
		 *   "https://<your-project>.pages.dev"
		 * Multiple origins must be comma-separated. Wildcards (*) are strictly rejected.
		 *
		 * Configure in production:
		 *   - via Cloudflare Dashboard: Workers & Pages > worker > Settings > Variables and Secrets
		 *   - or via wrangler.jsonc env.production.vars
		 */
		"ADMIN_ORIGINS": "http://localhost:5173",
		"COOKIE_SAME_SITE": "Lax",
		"COOKIE_NAME": "tapme_session"
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tapme-database",
			"database_id": "94cc3153-c4bf-4848-aaaf-190291e3ff89",
			"migrations_dir": "migrations"
		}
	],

	"ratelimits": [
		{
			"name": "AUTH_IP_LIMITER",
			"namespace_id": "78101",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "AUTH_ACCOUNT_LIMITER",
			"namespace_id": "78102",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	]
}
